DATABASE_URL=postgresql+asyncpg://spreadsheet_analyser:spreadsheet_analyser@localhost:5432/spreadsheet_analyser
REDIS_URL=redis://localhost:6379/0

# Keycloak (see docker/keycloak/realm-spreadsheet-analyser.json for the dev realm/client/user)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=spreadsheet-analyser
KEYCLOAK_CLIENT_ID=spreadsheet-analyser-backend
KEYCLOAK_CLIENT_SECRET=dev-only-secret-not-for-prod
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
SESSION_COOKIE_SECURE=false

# S3 object storage (RustFS locally; AWS_* naming so it is portable to real S3)
AWS_ACCESS_KEY_ID=rustfsadmin
AWS_SECRET_ACCESS_KEY=rustfsadmin
AWS_REGION=us-east-1
AWS_ENDPOINT_URL_S3=http://localhost:9000
AWS_S3_BUCKET=spreadsheet-analyser

# Shared secret between backend and worker (/api/internal/*); same value on both sides
INTERNAL_API_TOKEN=dev-only-internal-token
